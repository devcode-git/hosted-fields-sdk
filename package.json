{
  "name": "hosted-fields-sdk",
  "version": "1.3.5",
  "description": "Hosted fields sdk",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./esm": {
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "test": "test",
    "eslint": "eslint src",
    "build": "rimraf dist && npm run eslint && npm run build:cjs && npm run build:esm && npm run uglify",
    "build:cjs": "babel src --out-dir dist --env-name cjs",
    "uglify": "recursive-uglifyjs dist",
    "build:esm": "babel src --out-dir dist/esm --extensions '.js' --env-name esm",
    "check:brand": "node scripts/check-brand-package.mjs",
    "check:brand:test": "node scripts/check-brand-package.test.mjs"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/eslint-parser": "^7.26.5",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.7",
    "babel-plugin-rewire": "^1.2.0",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "eslint": "^8.57.1",
    "jasmine-core": "^4.0.1",
    "ncp": "^2.0.0",
    "recursive-uglifyjs": "0.2.0",
    "rimraf": "^3.0.2",
    "watchify": "^4.0.0"
  },
  "keywords": [
    "UI",
    "Payments"
  ],
  "license": "ISC",
  "dependencies": {
    "@babel/runtime": "^7.27.0"
  },
  "overrides": {
    "pbkdf2": "3.1.3",
    "sha.js": "2.4.12"
  }
}
